# Environment Configuration
# Copy this to .env and fill in your values

# App Settings
APP_NAME=Whispers of the Wires
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=your-secret-key-change-this-in-production

# Server
HOST=0.0.0.0
PORT=8501
API_PORT=8000

# Redis (for caching and task queue)
REDIS_URL=redis://localhost:6379/0

# Hugging Face (free, no token needed for public models)
# HF_TOKEN=hf_xxx  # Optional: for higher rate limits

# Storage
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
MAX_FILE_SIZE=50MB

# Model Settings
MODEL_CACHE_DIR=./models
DEFAULT_MODEL=facebook/musicgen-small
FALLBACK_MODEL=facebook/musicgen-small

# Generation Defaults
DEFAULT_DURATION=10
MAX_DURATION=120
DEFAULT_TEMPERATURE=1.0
